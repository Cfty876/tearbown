{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/play/(.*)\\.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
    { "source": "/play/(.*)\\.pck", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] },
    { "source": "/release-config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
