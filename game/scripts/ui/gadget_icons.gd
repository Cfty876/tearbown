class_name GadgetIcons
extends RefCounted

const PIXELS := [
	["......##....", ".....####...", "....#..##...", "...######...", "...#++++#...", "...#.#++#...", "...#++++#...", "...#++#.#...", "...#++++#...", "...######...", "....####....", "............"],
	[".....#......", ".....##.....", "....+##.....", ".....++.....", "....####....", "...######...", "...#++++#...", "...#++++#...", "...#++#+#...", "...#++++#...", "...######...", "....####...."],
	["....####....", "...######...", "...#++++#...", "...#++#.#...", "...#+##.#...", "...#.##+#...", "...#.#++#...", "...#++++#...", "...#++++#...", "...######...", "....####....", "............"],
	[".....##.....", "....####....", "...######...", "..##++++##..", "..#++#+++#..", "..#++#+++#..", "..#++###.#..", "..#++++++#..", "..##++++##..", "...######...", "....####....", ".....##....."],
]


static func build() -> Array[ImageTexture]:
	var icons: Array[ImageTexture] = []
	for id in PIXELS.size():
		var image := Image.create(12, 12, false, Image.FORMAT_RGBA8)
		var tint: Color = GameGadgets.TINTS[id]
		for y in 12:
			for x in 12:
				var mark: String = PIXELS[id][y][x]
				if mark != ".":
					image.set_pixel(x, y, tint.lightened(0.34) if mark == "#" else tint.darkened(0.36))
		icons.append(ImageTexture.create_from_image(image))
	return icons
